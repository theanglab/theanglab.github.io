---
import Layout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import NewsCard from '../components/NewsCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const allNews = (await getCollection('news')).filter(n => !n.data.draft).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const papers = (await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year).slice(0,3);
const topics = (await getCollection('research')).sort((a,b)=>(a.data.order??99)-(b.data.order??99));
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light">RESEARCH GROUP · UNIVERSITY OF YORK</p>
        <h1>{site.hero_title}</h1>
        <p class="hero-lead">{site.hero_description}</p>
        <div class="button-row"><a class="button button-mint" href="/research/">Explore our research <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/people/">Meet the team <span aria-hidden="true">→</span></a></div>
      </div>
      <div class:list={['hero-visual', {'hero-with-photo': Boolean(site.hero_image)}]}>
        {site.hero_image ? <img src={site.hero_image} alt="Ang Lab research image" /> : <div class="hero-rings" aria-hidden="true"><span></span><span></span><span></span></div>}
        <span class="hero-photo-caption">INSECT BIOLOGY / REIMAGINED</span>
      </div>
    </div>
  </section>
  <section class="intro-section wrap section-space">
    <p class="eyebrow">THE LAB / 01</p>
    <div><h2>{site.intro_heading}</h2><p>{site.intro_text}</p></div>
  </section>
  <section class="cream-section section-space">
    <div class="wrap"><SectionTitle eyebrow="OUR WORK / 02" title="Research themes" intro="From understanding insect systems to engineering new possibilities." />
      <div class="theme-grid">{topics.map((topic,i)=>(
        <a href={`/research/${topic.id}/`} class="theme-card">
          <div class="theme-image">{topic.data.image ? <img src={topic.data.image} alt="" loading="lazy" /> : <span class="theme-shape" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>}</div>
          <div class="theme-copy"><span class="meta">RESEARCH {String(i+1).padStart(2,'0')}</span><h3>{topic.data.title}</h3><p>{topic.data.summary}</p><span class="theme-link">Explore →</span></div>
        </a>
      ))}</div>
    </div>
  </section>
  <section class="section-space wrap news-preview">
    <SectionTitle eyebrow="FROM THE LAB / 03" title="Latest news" intro="Updates from our people, research and lab life." />
    {allNews.length ? <div class="news-stack">{allNews.slice(0,4).map(n=><NewsCard item={n} compact />)}</div> : <p class="empty-note">Lab news will appear here soon.</p>}
    <a class="text-link" href="/news/">View all news <span aria-hidden="true">↗</span></a>
  </section>
  <section class="cream-section section-space">
    <div class="wrap"><SectionTitle eyebrow="KNOWLEDGE SHARED / 04" title="Recent publications" intro="Peer-reviewed research and scientific contributions." />
      {papers.length ? <div class="pub-stack">{papers.map(p=><PublicationItem item={p} />)}</div> : <p class="empty-note">Selected publications will be added here shortly.</p>}
      <a class="text-link" href="/publications/">All publications <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="join-band"><div class="wrap join-inner"><div><p class="eyebrow eyebrow-light">WORK WITH US</p><h2>Curiosity moves science forward.</h2><p>We are always interested in exchanging ideas with researchers and potential collaborators.</p></div><a class="button button-mint" href="/join-us/">Join the conversation <span aria-hidden="true">↗</span></a></div></section>
</Layout>
